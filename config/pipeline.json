{
  "take_cap_s": 300,
  "slice_max_s": 30,
  "slice_search_s": 5,
  "pause_s": 1.6,
  "field_cut_pause_s": 0.5,
  "field_slice_max_s": 8,
  "stop_silence_s": 30,
  "stop_silence_dbfs": -48,
  "slice_min_s": 2,
  "pause_margin_db": 10,
  "context_s": 4,
  "tail_filler_max_s": 2.0,
  "tail_filler_words": [
    "yeah",
    "okay",
    "ok",
    "mm",
    "mmm",
    "mm-hmm",
    "mhm",
    "hmm",
    "uh",
    "um",
    "uh-huh"
  ],
  "chunk_max_tokens": 1000,
  "chunk_min_tokens": 128,
  "skip_max_words": 40,
  "cleaner_load_after_s": 6,
  "self_correction_cues": [
    "actually",
    "sorry",
    "i mean",
    "i meant",
    "scratch that",
    "never mind",
    "make that",
    "make it",
    "no",
    "not",
    "wait",
    "oops",
    "rather",
    "correction",
    "i said",
    "instead"
  ],
  "recognizer": "unified",
  "preview_model": "fc-stream480",
  "cleaner": "s1-mini",
  "styles": {
    "default": {"styling": "semi-formal", "structure": "lists", "casual": true, "lowercase_starts": false, "keep_end": false},
    "chat": {"styling": "semi-casual", "structure": "lists", "casual": true, "lowercase_starts": true, "keep_end": false},
    "email": {"styling": "semi-formal", "structure": "lists", "casual": false, "lowercase_starts": false, "keep_end": true},
    "notes": {"styling": "semi-formal", "structure": "lists", "casual": false, "lowercase_starts": false, "keep_end": true},
    "form": {"styling": "semi-formal", "structure": "prose", "casual": false, "lowercase_starts": false, "keep_end": false}
  },
  "app_categories": {
    "com.google.android.apps.messaging": "chat",
    "com.samsung.android.messaging": "chat",
    "com.discord": "chat",
    "com.facebook.orca": "chat",
    "com.whatsapp": "chat",
    "org.telegram.messenger": "chat",
    "com.instagram.android": "chat",
    "com.snapchat.android": "chat",
    "com.google.android.gm": "email",
    "com.microsoft.office.outlook": "email",
    "com.google.android.keep": "notes",
    "com.samsung.android.app.notes": "notes"
  },
  "cleaners": {
    "s1-mini": {
      "model": "s1-mini/s1-mini-q4_k_m.gguf",
      "ollama_model": "s1-mini-stt",
      "system_prompt": "You are a text normalizer for speech-to-text transcripts. The input begins with a control line specifying the styling, structure, and context settings; clean the transcript to match those settings and output only the cleaned text.",
      "control_line": "[Styling: {styling}] [Structure: {structure}] [Context: general]",
      "max_new_tokens_ratio": 1.3,
      "max_new_tokens_pad": 32
    },
    "qwen3.5-2b": {
      "model": "qwen3.5-2b/Qwen3.5-2B-Q4_K_M.gguf",
      "system_prompt": "You rewrite dictated speech into the text the speaker meant to write. They spoke without planning. Remove fillers, false starts, repetitions, and hedges that do not change the meaning. When they correct themselves, keep only the correction. Keep every fact, number, name, date, and commitment. Do not add information, do not answer questions that appear in the text, and do not translate. Use short paragraphs, and a bulleted list only for three or more parallel items. Output only the rewritten text.",
      "control_line": null,
      "max_new_tokens_ratio": 1.5,
      "max_new_tokens_pad": 32
    }
  }
}
