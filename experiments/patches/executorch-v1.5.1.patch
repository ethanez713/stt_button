+
+def _node_info(node):
+    return node.name + (
+        str(node.meta["nn_module_stack"].values())
+        if node.op == "call_function"
+        else ""
+    )
+
+
+def _resolve_param_target(node):
+    return (
+        node
+        if node.op == "call_function" and node.target not in _QDQ_TARGET
+        else _resolve_param_target(list(node.users)[0])
+    )
+
+
+def _encoding_nodes(model):
+    """Activation and parameter nodes in the order both halves of the encoding transfer pair them."""
+    parameters = {
+        n: _resolve_param_target(n) for n in model.graph.nodes if n.op == "get_attr"
+    }
+    activations = [
+        n
+        for n in model.graph.nodes
+        if n.target not in _QDQ_TARGET and n.op in {"call_function", "placeholder"}
+    ]
+    return activations, parameters
+
+
+def _target_key(target):
+    """A process-independent name for a node target, so encodings can be compared after pickling."""
+    if isinstance(target, (str, torch._ops.OpOverload, torch._ops.OpOverloadPacket)):
+        return str(target)
+    return f"{getattr(target, '__module__', None)}.{getattr(target, '__qualname__', target)}"
+
+
+def _qdq_chain(node):
+    """The q/dq arguments hanging off node's users, recursively, as the transfer copies them."""
+    chain = []
+    for user in node.users:
+        if user.name == "output":
+            chain.append(None)
+            continue
+        qdq_args = children = None
+        if user.target in _QDQ_TARGET:
+            qdq_args = tuple(user.args[1:])
+            assert not any(
+                isinstance(a, torch.fx.Node) for a in qdq_args
+            ), f"q/dq {user} takes graph nodes as encodings"
+            children = _qdq_chain(user)
+        chain.append((_target_key(user.target), qdq_args, children))
+    return chain
+
+
+def _apply_qdq_chain(chain, node):
+    for entry, user in zip(chain, list(node.users)):
+        if entry is None:
+            continue
+        target, qdq_args, children = entry
+        assert target == _target_key(user.target), f"found unmatched targets: {target} vs {user.target}"
+        if qdq_args is not None:
+            user.args = (user.args[0], *qdq_args)
+            _apply_qdq_chain(children, user)
+
+
+def _get_attr(module, target):
+    for atom in target.split("."):
+        module = getattr(module, atom)
+    return module
+
+
+def _set_attr(module, target, value):
+    *path, last = target.split(".")
+    for atom in path:
+        module = getattr(module, atom)
+    setattr(module, last, value)
+
+
+def _extract_encodings(quantized_model, override_kv_cache):
+    """Everything the encoding transfer reads from the calibrated graph, keyed by node order.
+
+    Picklable, so a staged export can hand a graph's encodings to the next process.
+    """
+    activations, parameters = _encoding_nodes(quantized_model)
+    table = {
+        "activations": [(_node_info(n), _qdq_chain(n)) for n in activations],
+        "parameters": [
+            (
+                _node_info(resolved),
+                _get_attr(quantized_model, node.target),
+                _qdq_chain(node) if list(node.users)[0].target in _PTQ_TARGET else None,
+            )
+            for node, resolved in parameters.items()
+        ],
+        "kv_cache": None,
+    }
+    if override_kv_cache:
+        k_chains, v_chains = [], []
+        for node in quantized_model.graph.nodes:
+            if not is_graph_output(node):
+                continue
+            cache_output_node = node.args[0].args[0]
+            if is_node_src_start_with_name(cache_output_node, kv_cache_prefix="k_"):
+                k_chains.append(_qdq_chain(cache_output_node))
+            elif is_node_src_start_with_name(cache_output_node, kv_cache_prefix="v_"):
+                v_chains.append(_qdq_chain(cache_output_node))
+        if not k_chains or not v_chains:
+            raise RuntimeError(
+                "KV cache detection failed. This likely means the model naming "
+                "does not match expected prefixes."
+            )
+        table["kv_cache"] = (k_chains, v_chains)
+    return table
+
+
+def _save_encodings(table, path):
+    import pickle
+
+    for section in ("activations", "parameters"):
+        for entry in table[section]:
+            try:
+                pickle.dumps(entry)
+            except Exception as e:
+                raise RuntimeError(f"{section} entry for {entry[0]} is not picklable: {entry}") from e
+    torch.save(table, path)
+
+
+def _apply_encodings(table, unquantized_model, n_cache_layers):
+    activations, parameters = _encoding_nodes(unquantized_model)
+    # check topology order by node name & nn_module_stack
+    for (info, _), node in zip(table["activations"], activations):
+        assert info == _node_info(node), f"found unmatched order for ops: {info} vs {node}"
+    for (info, _, _), resolved in zip(table["parameters"], parameters.values()):
+        assert info == _node_info(resolved), f"found unmatched order for ops: {info} vs {resolved}"
+
+    for (_, chain), node in zip(table["activations"], activations):
+        _apply_qdq_chain(chain, node)
+    for (_, source, chain), node in zip(table["parameters"], parameters.keys()):
+        # A CALIBRATE graph shorter than max_context_len has shorter RoPE tables; keep the
+        # target's own tensor and copy only its quantization parameters.
+        target = _get_attr(unquantized_model, node.target)
+        if not (
+            isinstance(source, torch.Tensor)
+            and isinstance(target, torch.Tensor)
+            and source.shape != target.shape
