+def _save_lowering_input(decoder: "TextDecoder", path: str) -> None:
+    """Save what compile() needs from a quantized TextDecoder: the program the QNN lowering would
+    export from it, and the attributes its passes read. Round-tripping the program through disk must
+    not change it, so the reload is compared node by node before the stage reports done."""
+    ep = torch.export.export(decoder.decoder, decoder.export_input, strict=True)
+    torch.export.save(ep, f"{path}.pt2")
+    state = {
+        "meta": decoder.meta,
+        "io_shape": decoder.io_shape,
+        "kv_cache_shape": decoder.kv_cache_shape,
+        "fixed_point_type": decoder.passes_job[TagQuantIO][
+            QCOM_PASS_ARGS_KWARGS_DEFAULTS_KEY
+        ]["get_quant_io_dtype_fn"].keywords["fixed_point_type"],
+    }
+    torch.save(state, f"{path}_state.pt")
+    reloaded = torch.export.load(f"{path}.pt2")
+    saved_nodes = [(n.name, n.op, str(n.target)) for n in ep.graph.nodes]
+    loaded_nodes = [(n.name, n.op, str(n.target)) for n in reloaded.graph.nodes]
+    assert saved_nodes == loaded_nodes, f"{path}.pt2 does not round-trip"
+    for a, b in zip(ep.graph.nodes, reloaded.graph.nodes):
+        if "val" in a.meta:
+            assert getattr(a.meta["val"], "shape", None) == getattr(
+                b.meta["val"], "shape", None
+            ), f"{path}.pt2: shape of {a.name} changed on reload"
+    saved = {**ep.state_dict, **ep.constants}
+    loaded = {**reloaded.state_dict, **reloaded.constants}
+    assert saved.keys() == loaded.keys(), f"{path}.pt2: tensors changed on reload"
+    for key, tensor in saved.items():
+        if isinstance(tensor, torch.Tensor):
+            assert torch.equal(tensor, loaded[key]), f"{path}.pt2: {key} changed on reload"
+
