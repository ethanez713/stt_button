+def export_stage():
+    """ET_QNN_STAGE runs one stage of the hybrid export per process: calibrate, decode, prefill or
+    compile. Each stage saves what the next one loads into the artifact directory, so no process
+    carries another stage's graphs. Unset, the whole export runs in one process."""
+    stage = os.environ.get("ET_QNN_STAGE")
+    assert stage in (None, "calibrate", "decode", "prefill", "compile"), stage
+    return stage
+
+
+def _stage_path(control_args, name):
+    return os.path.join(control_args.artifact, f"stage_{name}")
+
+
+def _finish_stage(control_args, stage):
+    open(_stage_path(control_args, f"{stage}.done"), "w").close()
+    logging.info(f"export stage {stage} done")
+    sys.exit(0)
+
