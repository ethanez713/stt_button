+def _drop_unreferenced_tensors(graph_module: torch.fx.GraphModule) -> None:
+    """convert_pt2e folds each quantized weight into a new constant but leaves the fp32 original attached."""
+    referenced = {n.target for n in graph_module.graph.nodes if n.op == "get_attr"}
+    dropped = 0
+    for name, tensor in list(graph_module.named_parameters()) + list(graph_module.named_buffers()):
+        if name in referenced:
+            continue
+        owner_path, _, leaf = name.rpartition(".")
+        owner = graph_module.get_submodule(owner_path) if owner_path else graph_module
+        owner._parameters.pop(leaf, None)
+        owner._buffers.pop(leaf, None)
+        dropped += tensor.numel() * tensor.element_size()
+    _release_export_leftovers()
+    logging.info(f"dropped {dropped // 2**20} MB of tensors no longer referenced after convert_pt2e")
+
