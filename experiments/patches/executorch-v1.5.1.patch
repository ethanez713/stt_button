+def _load_lowering_input(path: str, control_args) -> "TextDecoder":
+    """A TextDecoder shell holding a staged program and the attributes compile() and _tag_ios read."""
+    state = torch.load(f"{path}_state.pt", weights_only=False)
+    decoder = TextDecoder.__new__(TextDecoder)
+    decoder.control_args = control_args
+    decoder.meta = state["meta"]
+    decoder.io_shape = state["io_shape"]
+    decoder.kv_cache_shape = state["kv_cache_shape"]
+    decoder.decoder = torch.export.load(f"{path}.pt2")
+    decoder.tok_embedding = None
+    decoder.export_input = None
+    decoder.pass_manager_cls = get_qnn_pass_manager_cls()
+    decoder.passes_job = decoder.pass_manager_cls.get_capture_program_passes()
+    decoder.dep_table = decoder.pass_manager_cls.get_passes_dependency_for_capture_program()
+    decoder.passes_job[TagQuantIO][QCOM_PASS_ACTIVATE_KEY] = True
+    decoder.passes_job[TagQuantIO][QCOM_PASS_ARGS_KWARGS_DEFAULTS_KEY][
+        "get_quant_io_dtype_fn"
+    ] = partial(decoder._tag_ios, fixed_point_type=state["fixed_point_type"])
+    return decoder
