+def _release_export_leftovers() -> None:
+    """Free the weights still pinned by dead intermediates of export, prepare/convert and SeqMSE.
+
+    Strict torch.export, prepare_pt2e and convert_pt2e each leave an earlier GraphModule of the whole
+    model reachable through bound methods and closures, and SeqMSE leaves its per-op modules behind;
+    each holds full fp32 copies of the weights. Only modules outside every live TextDecoder's graphs are
+    cleared, so a submodule shared with a live graph is never touched.
+    """
+    from executorch.backends.qualcomm._passes.seq_mse import SeqMseModule
+
+    torch._dynamo.reset()
+    gc.collect()
+    live = set()
+    for obj in gc.get_objects():
+        if isinstance(obj, TextDecoder):
+            for graph in (obj.decoder, obj.tok_embedding):
+                if isinstance(graph, torch.nn.Module):
+                    live.update(id(m) for m in graph.modules())
+    freed = 0
+    for obj in gc.get_objects():
+        if isinstance(obj, torch.fx.GraphModule) and id(obj) not in live:
+            for m in obj.modules():
+                if id(m) in live:
+                    continue
+                for t in list(m._parameters.values()) + list(m._buffers.values()):
+                    if t is not None:
+                        freed += t.numel() * t.element_size()
+                m._parameters.clear()
+                m._buffers.clear()
+        elif isinstance(obj, SeqMseModule) and obj.nominal_weight is not None:
+            freed += obj.nominal_weight.numel() * obj.nominal_weight.element_size()
+            obj.nominal_weight = None
+            obj.nominal_bias = None
+            obj.operator = None
+    gc.collect()
+    # glibc keeps freed small allocations in its arenas; hand them back so RSS reflects live data.
+    import ctypes
+
+    ctypes.CDLL("libc.so.6").malloc_trim(0)
+    logging.info(f"released {freed // 2**20} MB held by dead export intermediates and SeqMSE modules")
+
